# Two OBP instances, LOCAL and PROD: each setting prefixed with its target. The
# scripts use LOCAL unless run with --target=PROD / --target=BOTH (the .sh
# wrappers) or OBP_TARGET=PROD (a .py run directly). See "LOCAL and PROD" in the README.
# Any setting below can be prefixed; one left unprefixed is shared by both.
LOCAL_OBP_HOSTNAME=http://localhost:8080
LOCAL_OBP_USERNAME=myusername
LOCAL_OBP_PASSWORD=mysecretpassword
LOCAL_OBP_CONSUMER_KEY=myconsumerkey
# LOCAL_OBP_ENTITY_SPACE_ID=ogcr

PROD_OBP_HOSTNAME=https://dcr.ogcr.tesobe.com
PROD_OBP_USERNAME=myusername
PROD_OBP_PASSWORD=mysecretpassword
PROD_OBP_CONSUMER_KEY=myconsumerkey
# PROD_OBP_ENTITY_SPACE_ID=ogcr

OBP_LOG_LEVEL=INFO
# How the scripts log in (see "Logging in: user or Platform App" in the README):
#   user     (default) DirectLogin with <TARGET>_OBP_USERNAME / _PASSWORD / _CONSUMER_KEY above
#   platform as a Platform App, with an OAuth2 client credentials token from OBP-OIDC
# LOCAL_OBP_AUTH_MODE=user
# LOCAL_OIDC_ISSUER=http://localhost:9000/obp-oidc
# LOCAL_OIDC_CLIENT_ID=
# LOCAL_OIDC_CLIENT_SECRET=
# Optional parameters
# The bank (aka Space) that owns the OGCR dynamic entities. Unset = ogcr, the
# same default as OGCR-App and OGCR-chain-cache. Set it to the empty string for
# system level. recreate_dynamic_entities.sh creates the bank if it doesn't exist.
# OBP_ENTITY_SPACE_ID=ogcr

# Controls whether created/updated dynamic entities expose per-user records
# Set to true/1/yes to enable
HAS_PERSONAL_ENTITY=false

# Controls whether created/updated dynamic entities grant community access
# Set to true/1/yes to enable
HAS_COMMUNITY_ACCESS=false
